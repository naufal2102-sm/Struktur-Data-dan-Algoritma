acak = [57, 14, 83, 29, 66, 41, 95, 8, 72, 35, 50, 19, 88, 62, 24, 77, 3, 46, 91, 11]
data = sorted(acak)
print("Data acak  :", acak)
print("Data urut  :", data)
print("Jumlah     :", len(data), "elemen\n")


def binary_search_trace(data, target):
    left, right = 0, len(data) - 1
    pemeriksaan = 0
    while left <= right:
        mid = (left + right) // 2
        pemeriksaan += 1
        nilai = data[mid]
        info = f"  left={left:<3}right={right:<3}mid={mid:<3}data[mid]={nilai:<4}"
        if nilai == target:
            print(info + "-> ketemu")
            return (mid, pemeriksaan)
        elif nilai < target:
            print(info + "-> terlalu kecil, left = mid + 1")
            left = mid + 1
        else:
            print(info + "-> terlalu besar, right = mid - 1")
            right = mid - 1
    print("  left > right -> tidak ditemukan")
    return (-1, pemeriksaan)


def linear_search(data, target):
    pemeriksaan = 0
    for i in range(len(data)):
        pemeriksaan += 1
        if data[i] == target:
            return (i, pemeriksaan)
    return (-1, pemeriksaan)


hasil_binary = {}
pengujian = [("Sekitar tengah", 50), ("Dekat awal", 11), ("Dekat akhir", 91), ("Tidak ada", 60)]

for nama, target in pengujian:
    print(f"{nama}: cari {target}")
    idx, n = binary_search_trace(data, target)
    hasil_binary[target] = (idx, n)
    print(f"  Hasil: index = {idx}, pemeriksaan = {n}\n")

print("Data diacak: binary search pada data TIDAK terurut")
for target in (11, 83):
    print(f"Cari {target} (target ADA di list acak, index {acak.index(target)})")
    idx, n = binary_search_trace(acak, target)
    print(f"  Hasil: index = {idx}, pemeriksaan = {n}\n")

print("Perbandingan Binary vs Linear (data terurut)")
print(f"{'Target':<10}{'Binary':<10}{'Linear':<10}")
for nama, target in pengujian:
    b = hasil_binary[target][1]
    l = linear_search(data, target)[1]
    print(f"{target:<10}{b:<10}{l:<10}")
