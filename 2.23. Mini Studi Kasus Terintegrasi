def binary_search_trace(data, target):
    left, right = 0, len(data) - 1
    pemeriksaan = 0
    while left <= right:
        mid = (left + right) // 2
        pemeriksaan += 1
        print(f"  left={left:<3}right={right:<3}mid={mid:<3}data[mid]={data[mid]}")
        if data[mid] == target:
            return mid, pemeriksaan
        elif data[mid] < target:
            left = mid + 1
        else:
            right = mid - 1
    return -1, pemeriksaan

print("\nSoal 7: Binary Search nilai 88 pada data terurut")
idx, n = binary_search_trace(terurut, 88)
print(f"  Ditemukan di indeks {idx} setelah {n} pemeriksaan")
