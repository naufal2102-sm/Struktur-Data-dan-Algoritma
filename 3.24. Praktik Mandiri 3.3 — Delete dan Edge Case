class Node:
    def __init__(self, data):
        self.data = data
        self.next = None


class SinglyLinkedList:
    def __init__(self):
        self.head = None
        self.size = 0

    def append(self, data):
        new_node = Node(data)
        if self.head is None:
            self.head = new_node
        else:
            current = self.head
            while current.next is not None:
                current = current.next
            current.next = new_node
        self.size += 1

    # Menghapus kemunculan PERTAMA nilai target.
    # Mengembalikan True jika berhasil, False jika tidak ditemukan.
    def delete(self, target):
        # Kasus 1: list kosong
        if self.head is None:
            return False

        # Kasus 2: yang dihapus adalah head
        if self.head.data == target:
            self.head = self.head.next
            self.size -= 1
            return True

        # Kasus 3: node tengah / terakhir, perlu previous
        previous = self.head
        current = self.head.next
        while current is not None:
            if current.data == target:
                previous.next = current.next   # lewati node current
                self.size -= 1
                return True
            previous = current
            current = current.next

        # Kasus 4: nilai tidak ditemukan
        return False

    def to_list(self):
        hasil = []
        current = self.head
        while current is not None:
            hasil.append(current.data)
            current = current.next
        return hasil

    def to_string(self):
        if self.head is None:
            return "(kosong)"
        return " -> ".join(str(x) for x in self.to_list()) + " -> None"

    def hitung_node(self):
        # Menghitung node sebenarnya, untuk memeriksa konsistensi size
        n = 0
        current = self.head
        while current is not None:
            n += 1
            current = current.next
        return n


def tampil(ll, judul, hasil):
    print(judul)
    print("  Hasil delete :", hasil)
    print("  Isi list     :", ll.to_string())
    print("  Jumlah node  :", ll.size)
    print()


# ===== Soal 1: delete pada list kosong =====
ll = SinglyLinkedList()
tampil(ll, "1. Hapus 10 dari list kosong", ll.delete(10))

# ===== Soal 2: list satu node, lalu dihapus =====
ll = SinglyLinkedList()
ll.append(10)
tampil(ll, "2a. List satu node (sebelum dihapus)", "-")
tampil(ll, "2b. Hapus 10 (satu-satunya node)", ll.delete(10))

# ===== Soal 3: list 5 node, hapus head, tengah, terakhir =====
ll = SinglyLinkedList()
for nilai in (10, 20, 30, 40, 50):
    ll.append(nilai)
tampil(ll, "3a. List awal", "-")
tampil(ll, "3b. Hapus head (10)", ll.delete(10))
tampil(ll, "3c. Hapus node tengah (30)", ll.delete(30))
tampil(ll, "3d. Hapus node terakhir (50)", ll.delete(50))

# ===== Soal 4: hapus nilai yang tidak ada =====
tampil(ll, "4. Hapus 99 (tidak ada)", ll.delete(99))

