def cek(nama, kondisi):
    assert kondisi, "GAGAL: " + nama
    print("LULUS:", nama)

# A. Nilai duplikat: hanya kemunculan pertama yang dihapus
t = SinglyLinkedList()
for x in (1, 2, 2, 3):
    t.append(x)
t.delete(2)
cek("duplikat, hanya satu '2' terhapus", t.to_list() == [1, 2, 3])

# B. Hapus node tepat setelah head
t = SinglyLinkedList()
for x in (1, 2, 3):
    t.append(x)
t.delete(2)
cek("hapus node kedua, head tetap tersambung ke 3", t.to_list() == [1, 3])

# C. Hapus nilai yang sama dua kali
t = SinglyLinkedList()
t.append(5)
cek("hapus 5 pertama kali berhasil", t.delete(5) is True)
cek("hapus 5 kedua kali mengembalikan False", t.delete(5) is False)

# D. Append kembali setelah list dikosongkan
t.append(7)
cek("append setelah list kosong", t.to_list() == [7] and t.size == 1)

# E. Hapus node terakhir lalu append: sambungan tidak boleh putus
t = SinglyLinkedList()
t.append(1)
t.append(2)
t.delete(2)
t.append(9)
cek("hapus ekor lalu append, hasil [1, 9]", t.to_list() == [1, 9])

# F. size harus selalu sama dengan jumlah node sebenarnya
t = SinglyLinkedList()
for x in (1, 2, 3, 4, 5):
    t.append(x)
t.delete(1); t.delete(99); t.delete(3); t.delete(5)
cek("size sama dengan jumlah node sebenarnya", t.size == t.hitung_node() == 2)

# G. Kosongkan seluruh list satu per satu
for x in (2, 4):
    t.delete(x)
cek("semua dihapus, head None dan size 0", t.head is None and t.size == 0)
